# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=family_inventory

# Deepseek API Key（不填则使用模拟 AI 识别）
DEEPSEEK_API_KEY=

# Deepseek API 基础地址（默认使用官网接口）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Flask 密钥（必填，用于 Token 签名，用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=

# 注册邀请码（只有知道邀请码的人才能注册，留空则禁止新用户注册）
REGISTRATION_CODE=
