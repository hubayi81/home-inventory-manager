# ============================================
#  家庭物品管家 - Docker 部署配置
#  使用方法：复制此文件为 .env，修改下面的值
# ============================================

# MySQL root 密码（必须修改！）
DB_PASSWORD=请修改为你的安全密码

# Flask 密钥（随便填一串随机字符）
SECRET_KEY=请修改为随机字符串

# Deepseek AI（不填则使用模拟识别）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
